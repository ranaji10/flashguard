# Never commit anything from the reference library
/library/
../library/

# Raw device output. Contains serials and other identifiers.
# Only scrubbed, schema-conformant records belong in data/device-matrix.jsonl
raw/
*-raw.txt
*.getprop
fastboot-*.txt

# Local
.DS_Store
.venv/
__pycache__/
node_modules/
*.pyc
.env

# Captures land here during a run; they are merged into data/ afterwards
bench-kit/device-matrix.jsonl
bench-kit/descriptors/
dist/

# The open-items tracker and its export. PRIVATE, deliberately untracked.
# They carry names and contract details belonging to people who did not sign up for this
# repository. tests/check-public-safe.sh scans TRACKED files only, so keeping these out of
# git is what actually protects them -- an exemption inside the scanner only hid them.
docs/tracker/
docs/open-items-snapshot.md
