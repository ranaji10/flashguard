{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"github.copilot.chat.reviewSelection.instructions": [
			{
				"file": ".github/copilot-review-instructions.md"
			},
			{
				"text": "A wrong 'safe' verdict can brick a phone. Flag anything that turns an uncertain result into a confident one; missing evidence must stay 'unknown', never a default."
			},
			{
				"text": "classify.sh, derive.sh and the verifier are pure functions over text. Flag any device I/O, network, filesystem or global state added to them."
			},
			{
				"text": "Nothing may write to a device. Flag fastboot flash/erase/format/oem/flashing, adb root/remount/disable-verity, dd, mkfs."
			},
			{
				"text": "Never read or store serial numbers, IMEI, IMSI, MAC, ICCID or Android ID. Flag getprop without an allowlist, 'adb devices' (use adb get-state), and lsusb -v that keeps iSerial."
			},
			{
				"text": "Shell must run on bash 3.2. Flag declare -A, mapfile, readarray, ${v,,}, ${v^^}, coproc."
			},
			{
				"text": "No machine-learning vocabulary. Nothing here is trained or inferred."
			}
		],
		"github.copilot.chat.codeGeneration.instructions": [
			{
				"file": ".github/copilot-review-instructions.md"
			},
			{
				"text": "Shell must run on bash 3.2, which macOS ships. Never use declare -A, mapfile, readarray, ${v,,} or ${v^^}."
			},
			{
				"text": "Never generate a command that writes to, flashes, erases or unlocks a device."
			},
			{
				"text": "Never read a device serial: use 'adb get-state', not 'adb devices'; strip iSerial from lsusb output."
			},
			{
				"text": "Prefer returning 'unknown' over inferring a value from an absent property."
			},
			{
				"text": "Never reproduce content from ../library/. It is borrowed material under other licences and must not enter this GPL repository."
			}
		],
		"github.copilot.chat.commitMessageGeneration.instructions": [
			{
				"text": "Say what changed and why it matters, in plain sentences. No conventional-commit prefixes."
			},
			{
				"text": "If the change fixes a defect, name what the defect would have caused."
			}
		]
	}
}
